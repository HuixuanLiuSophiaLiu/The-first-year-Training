#include <stdio.h>

#define N 3 // 3x3 网格节点

int main() {
    int dp[N][N] = {0};

    for (int row = 0; row < N; row++) {
        for (int col = 0; col < N; col++) {
            if (row == 0 && col == 0) {
                // 起点
                dp[row][col] = 1;
            } 
            else if (row > col) {
                // 左下角的海区域，不可达
                dp[row][col] = 0; 
            } 
            else if (row == col) {
                // 重点：在对角线上，左侧是海，只能从上方过来
                dp[row][col] = dp[row - 1][col]; 
            } 
            else { // row < col
                // 在对角线上方的陆地，可以从上方过来，也可以从左侧过来
                dp[row][col] = dp[row - 1][col] + dp[row][col - 1];
            }
        }
    }

    printf("Number of paths: %d\n\n", dp[N-1][N-1]);
    
    // 打印真实的 DP 矩阵
    printf("DP Table:\n");
    for (int row = 0; row < N; row++) {
        for (int col = 0; col < N; col++) {
            if (row > col) {
                // 这里就是海，直接打印 sea
                printf("  sea ");
            } else {
                printf("%5d ", dp[row][col]);
            }
        }
        printf("\n");
    }

    return 0;
}
