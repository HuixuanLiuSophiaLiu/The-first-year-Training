#include <stdio.h>

// 定义三角形的高度（图片中一共是 15 行）
#define ROWS 15

// 辅助函数：求两个整数中的最大值
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    // 1. 初始化原始三角形数据（将图片中的数据录入）
    // 注意：C语言中不能写 04, 01 这种形式，直接写 4, 1 即可
    int original[ROWS][ROWS] = {
        {75},
        {95, 64},
        {17, 47, 82},
        {18, 35, 87, 10},
        {20, 04, 82, 47, 65},
        {19, 01, 23, 75, 03, 34},
        {88, 02, 77, 73, 07, 63, 67},
        {99, 65, 04, 28, 06, 16, 70, 92},
        {41, 41, 26, 56, 83, 40, 80, 70, 33},
        {41, 48, 72, 33, 47, 32, 37, 16, 94, 29},
        {53, 71, 44, 65, 25, 43, 91, 52, 97, 51, 14},
        {70, 11, 33, 28, 77, 73, 17, 78, 39, 68, 17, 57},
        {91, 71, 52, 38, 17, 14, 91, 43, 58, 50, 27, 29, 48},
        {63, 66, 04, 68, 89, 53, 67, 30, 73, 16, 69, 87, 40, 31},
        {04, 62, 98, 27, 23, 09, 70, 98, 73, 93, 38, 53, 60, 04, 23}
    };

    // 2. 创建 DP 数组，并复制原始数据
    int dp[ROWS][ROWS];
    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j <= i; j++) {
            dp[i][j] = original[i][j];
        }
    }

    // 3. 自底向上进行动态规划
    // 从倒数第二行开始，逐层向上推导
    for (int i = ROWS - 2; i >= 0; i--) {//特别要注意这里的这个ROWS-2，不需要从最下面一行开始比较
        for (int j = 0; j <= i; j++) {
            // 当前节点的最大和 = 自身数值 + 正下方和右下方两个子节点的较大值
            dp[i][j] += max(dp[i+1][j], dp[i+1][j+1]);
        }
    }

    // 此时，dp[0][0] 就是整棵树的最大路径和
    printf("最大路径和为: %d\n\n", dp[0][0]);

    // 4. 回溯寻找具体路径（可选）
    printf("最佳路径为:\n");
    int j = 0; // 从第一行第一个位置开始
    int sum = 0;
    for (int i = 0; i < ROWS; i++) {
        printf("%02d ", original[i][j]);
        sum += original[i][j];
        
        // 如果不是最后一行，决定下一步是向左下走，还是向右下走
        if (i < ROWS - 1) {
            // 比较下方两个值，哪边大就往哪边走 (注意比较的是dp数组里的值)
            if (dp[i+1][j] > dp[i+1][j+1]) {
                // 选左边，j 不变
            } else {
                // 选右边，j 加 1
                j++;
            }
        }
    }
    printf("\n\n验证路径加和: %d\n", sum);//其实sum就是【0】【0】啊

    return 0;
}
